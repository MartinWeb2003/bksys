// Camp Desk — multi-tenant booking dashboard.
// Each Camp is a tenant: its ParcelTypes, Parcels and Bookings are isolated by campId.
// Isolation is enforced centrally in lib/data.ts — every query is scoped to a campId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled connection (Neon) for the app
  directUrl = env("DIRECT_URL")     // direct connection for migrations
}

model Camp {
  id           String          @id @default(cuid())
  name         String                                 // camp display name
  email        String          @unique                // login identity
  passwordHash String                                 // bcrypt hash — never plaintext
  createdAt    DateTime        @default(now())
  onboardedAt  DateTime?                              // null = must run onboarding; existing camps backfilled to createdAt
  unitNoun     String          @default("parcel")     // app-wide noun key (parcel/apartment/room/…) — drives UI relabeling
  businessKinds String         @default("camp")       // comma-joined onboarding choices (record of what they manage)
  types        ParcelType[]
  parcels      Parcel[]
  bookings     Booking[]
  resets       PasswordReset[]
  notes        Note[]
}

model Note {
  id        String   @id @default(cuid())
  campId    String
  camp      Camp     @relation(fields: [campId], references: [id], onDelete: Cascade)
  title     String   @default("")     // optional short label
  body      String   @db.Text         // the note text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  campId    String
  camp      Camp      @relation(fields: [campId], references: [id], onDelete: Cascade)
  tokenHash String    @unique          // sha256 of the emailed token — raw token is never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([campId])
}

model ParcelType {
  id      String   @id @default(cuid())
  campId  String
  camp    Camp     @relation(fields: [campId], references: [id], onDelete: Cascade)
  name    String                              // display label, e.g. "Parcel A" — admin-editable
  order   Int      @default(0)
  parcels Parcel[]

  @@unique([campId, name]) // unique per camp, not globally
  @@index([campId])
}

model Parcel {
  id       String     @id @default(cuid())
  campId   String
  camp     Camp       @relation(fields: [campId], references: [id], onDelete: Cascade)
  label    String                            // human-readable, e.g. "A1" — admin-editable
  typeId   String
  type     ParcelType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  capacity Int
  order    Int        @default(0)
  bookings Booking[]

  @@unique([campId, label]) // unique per camp
  @@index([campId])
  @@index([typeId])
}

enum BookingStatus {
  PAID // green  — paid for
  HERE_UNPAID // yellow — arrived / currently here but not paid
  BOOKED_FIXED // red    — future, not arrived, must stay on this parcel
  BOOKED_MOVABLE // orange — future, not paid/arrived, can be moved
}

model Booking {
  id        String        @id @default(cuid())
  campId    String
  camp      Camp          @relation(fields: [campId], references: [id], onDelete: Cascade)
  parcelId  String
  parcel    Parcel        @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  guestName String
  email     String?
  phone     String?
  arrival   DateTime      @db.Date
  departure DateTime      @db.Date
  people    Int
  status    BookingStatus @default(BOOKED_MOVABLE)
  confirmed Boolean       @default(true) // false = tentative, kept off the calendar (Nepotvrđeno)
  notes     String?       @db.Text
  createdAt DateTime      @default(now())

  @@index([campId])
  @@index([parcelId, arrival, departure])
}
